# =============================================================================
# EV Copilot MCP — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values.
# Values marked (CDK) come from CDK stack outputs after deployment.
# =============================================================================

# --- AWS ---
AWS_REGION=us-east-2

# --- AgentCore Memory ---
# Memory resource ID for user preferences (CDK output: MemoryId)
AGENTCORE_MEMORY_ID=

# --- Google Maps Platform API ---
# One server-side key for Places API (New), Routes API, Geocoding API,
# Elevation API and Weather API. Enable all five APIs on the key's project.
# For local development, set the API key directly:
GOOGLE_MAPS_API_KEY=
# In deployed environments the key is fetched from Secrets Manager via ARN (CDK):
# GOOGLE_MAPS_SECRET_ARN=arn:aws:secretsmanager:us-east-2:ACCOUNT:secret:evCopilot/google-maps-api-key-XXXXXX
GOOGLE_MAPS_SECRET_ARN=

# --- Open Charge Map API ---
# Get your free API key at https://openchargemap.org (sign in -> My Profile -> My Apps)
# For local development, set the API key directly:
OPEN_CHARGE_MAP_API_KEY=
# In deployed environments the key is fetched from Secrets Manager via ARN (CDK):
# OPEN_CHARGE_MAP_SECRET_ARN=arn:aws:secretsmanager:us-east-2:ACCOUNT:secret:evCopilot/openchargemap-api-key-XXXXXX
OPEN_CHARGE_MAP_SECRET_ARN=

# --- Bedrock Prompt Management ---
# Prompt ID for the agent scope prompt (CDK output: AgentScopePromptId)
BEDROCK_PROMPT_ID=
# Prompt ID for the router intent classifier prompt (CDK output: RouterPromptId)
BEDROCK_PROMPT_ROUTER_ID=
# Prompt ID for the simple response prompt (CDK output: SimpleResponsePromptId)
BEDROCK_PROMPT_SIMPLE_ID=
# Prompt ID for the reflection quality review prompt (CDK output: ReflectionPromptId)
BEDROCK_PROMPT_REFLECTION_ID=
# Cache TTL for prompt text (seconds, default 300)
PROMPT_CACHE_TTL_SECONDS=300

# --- Observability (OpenTelemetry + CloudWatch) ---
AGENT_OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=evcopilot-mcp
OTEL_PYTHON_DISTRO=aws_distro
OTEL_PYTHON_CONFIGURATOR=aws_configurator
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
