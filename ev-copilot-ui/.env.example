# --- Connection Mode ---
# Set to "local" to connect to a locally running API server (default).
# Set to "aws" to invoke the deployed AgentCore Runtime on AWS.
AGENT_CONNECTION_MODE=local

# --- Local Mode Settings ---
# The URL of the local API server (used when AGENT_CONNECTION_MODE=local).
# When the UI runs inside Docker and the agent runs on the host, use http://host.docker.internal:8080/invocations
AGENTCORE_API_URL=http://localhost:8080/invocations

# --- AWS Mode Settings ---
# Required when AGENT_CONNECTION_MODE=aws. The ARN of the deployed AgentCore Runtime.
# Obtain from CDK stack output: aws cloudformation describe-stacks --stack-name evCopilot-AgentStack --query 'Stacks[0].Outputs[?OutputKey==`AgentRuntimeArn`].OutputValue' --output text
# AWS credentials come from the default provider chain (App Runner instance role, AWS profile or env vars).
AGENT_RUNTIME_ARN=
# AWS region where the runtime is deployed (defaults to us-east-2).
AWS_REGION=us-east-2

# --- Google Maps (browser map) ---
# Maps JavaScript API key used by the browser to render the map. Restrict it by HTTP referrer.
# Served to the browser at runtime via GET /api/config (no build-time NEXT_PUBLIC_* variables).
# Leave blank to run without the map (a placeholder panel is shown instead).
# The infra placeholder value REPLACE_ME is treated as blank.
GOOGLE_MAPS_BROWSER_API_KEY=
# Map ID for vector maps / Advanced Markers (defaults to DEMO_MAP_ID).
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
