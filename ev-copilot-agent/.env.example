# =============================================================================
# EV Copilot Agent — Environment Configuration
# =============================================================================

# --- App ---
# Must match the CDK appName (Cognito resource server prefix "<APP_NAME>-api"
# and Gateway target prefix "<APP_NAME>-McpTarget___")
APP_NAME=evCopilot

# --- AWS ---
AWS_REGION=us-east-2

# --- Local MCP (local development only) ---
# When set, tools AND prompts come from the local MCP server (no auth, no tool
# prefix) and GATEWAY_URL / RUNTIME_URL / COGNITO_* are ignored.
# e.g. http://localhost:8000/mcp (use http://host.docker.internal:8000/mcp from a container)
LOCAL_MCP_URL=

# --- AgentCore Gateway (for tool proxy and invocation) ---
# From CDK stack output: evCopilot-GatewayStack.GatewayUrl
GATEWAY_URL=
# From CDK stack output: evCopilot-GatewayStack.GatewayId
GATEWAY_ID=

# --- AgentCore Runtime (for prompts and resources via direct MCP client) ---
# Constructed from CDK: https://bedrock-agentcore.<region>.amazonaws.com/runtimes/<encoded-arn>/invocations?qualifier=DEFAULT
RUNTIME_URL=
# From CDK stack output: evCopilot-AgentCoreStack.RuntimeId
RUNTIME_ID=

# --- Cognito (JWT for the Gateway and the direct Runtime) ---
# From CDK stack output: evCopilot-AgentCoreStack.CognitoClientId
COGNITO_CLIENT_ID=
# Deployed: Secrets Manager ARN of the client secret, resolved at startup.
# From CDK stack output: evCopilot-AgentCoreStack.CognitoClientSecretArn
COGNITO_CLIENT_SECRET_ARN=
# Local development only (takes precedence over COGNITO_CLIENT_SECRET_ARN when set).
# Retrieved via: aws secretsmanager get-secret-value --secret-id evCopilot/cognito-client-secret
COGNITO_CLIENT_SECRET=
# From CDK stack output: evCopilot-AgentCoreStack.CognitoTokenEndpoint
COGNITO_TOKEN_ENDPOINT=

# --- AgentCore Memory ---
# From CDK stack output: evCopilot-AgentCoreStack.MemoryId
MEMORY_ID=

# --- Guardrails (from CDK — agent does NOT create these) ---
# From CDK stack output: evCopilot-AgentStack.GuardrailId
BEDROCK_GUARDRAIL_ID=
# Set to "LATEST" to auto-resolve the latest published version at startup, or pin a specific version number
BEDROCK_GUARDRAIL_VERSION=LATEST
GUARDRAIL_ENABLED=true

# --- Models (Bedrock Converse cross-region inference profile IDs) ---
ORCHESTRATOR_MODEL_ID=us.anthropic.claude-sonnet-4-6
ROUTER_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
REFLECTION_MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- Observability ---
AGENT_OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=ev-copilot-agent
